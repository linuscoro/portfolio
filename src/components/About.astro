---
import { Image } from "astro:assets";
import portrait from "../assets/about/portrait.jpeg";
import budapest from "../assets/about/budapest.jpeg";
import kayak from "../assets/about/kayak.jpeg";
import jiuJitsu from "../assets/about/jiu-jitsu.jpeg";

interface Props {
  content: {
    label: string;
    title: string;
    intro: string;
    photoAlts: { portrait: string; stories: string[] };
    blocks: { title: string; text: string }[];
  };
}

const { content } = Astro.props;
const storyPhotos = [budapest, kayak, jiuJitsu];
---

<section id="about" class="about" aria-labelledby="about-title">
  <p class="section-label">{content.label}</p>
  <div class="about__intro">
    <div class="about__bio">
    <h2 id="about-title">{content.title}</h2>
    <p>{content.intro}</p>
    </div>
    <Image class="about__portrait" src={portrait} alt={content.photoAlts.portrait}
      widths={[320, 480, 720]} sizes="(max-width: 800px) 80vw, 360px"
      width={360} format="webp" loading="lazy" />
  </div>
  <div class="about__stories">
    {content.blocks.map((block, index) => (
      <article class="about__story">
        <Image class="about__photo" src={storyPhotos[index]} alt={content.photoAlts.stories[index]}
          widths={[400, 640, 960]} sizes="(max-width: 800px) calc(100vw - 3rem), 33vw"
          width={640} format="webp" loading="lazy" />
        <span class="about__number" aria-hidden="true">0{index + 1}</span>
        <h3>{block.title}</h3>
        <p>{block.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .about {
    scroll-margin-top: 5rem;
  }

  .about__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 360px);
    gap: 3rem;
    align-items: center;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    white-space: pre-line;
    text-wrap: balance;
  }

  .about__bio > p {
    margin: 2rem 0 0;
    max-width: 58ch;
    font-family: monospace;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }

  .about__stories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .about__portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 25%;
    border: 2px solid var(--border);
    box-shadow: 8px 8px 0 var(--accent);
  }

  .about__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .about__story {
    border-top: 2px solid var(--border);
    padding-top: 1.25rem;
  }

  .about__number {
    color: var(--accent);
    font-family: monospace;
    font-weight: 700;
  }

  h3 {
    margin: 1rem 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .about__story p {
    margin: 0;
    line-height: 1.7;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .about__portrait {
      max-width: 360px;
      width: 80%;
      justify-self: center;
    }
    .about__intro,
    .about__stories {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

