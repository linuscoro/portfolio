---
import type { Project, ProjectLanguage } from "../data/projects";

interface Props {
  project: Project;
  language?: ProjectLanguage;
}

const { project, language = "ca" } = Astro.props;
const labels = {
  ca: { project: "PROJECTE", technologies: "Tecnologies", demo: "VEURE DEMO" },
  es: { project: "PROYECTO", technologies: "Tecnologías", demo: "VER DEMO" },
  en: { project: "PROJECT", technologies: "Technologies", demo: "LIVE DEMO" },
}[language];
---

<article class="project-card">
  <div class="project-card__number">
    {labels.project} / {String(project.id).padStart(2, "0")}
  </div>

  <div class="project-card__main">
    <h3>{project.title}</h3>
    {project.technologies.length > 0 && (
      <ul class="project-card__technologies" aria-label={labels.technologies}>
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    )}
    <p>{project.description}</p>
    {(project.github || project.demo) && (
      <div class="project-card__actions">
        {project.github && (
          <a href={project.github} target="_blank" rel="noreferrer">GITHUB ↗</a>
        )}
        {project.demo && (
          <a href={project.demo} target="_blank" rel="noreferrer">{labels.demo} ↗</a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 2px solid var(--border);
  }

  .project-card:last-child {
    border-bottom: 2px solid var(--border);
  }

  .project-card__number {
    padding-top: 0.4rem;
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--accent);
  }

  .project-card__main h3 {
    max-width: 850px;
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .project-card__main p {
    max-width: 800px;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .project-card__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    font-family: monospace;
    font-size: 1rem;
    font-weight: 700;
  }

  .project-card__technologies li {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
    font-family: monospace;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .project-card__actions a {
    padding: 0.25rem 0;
    border-bottom: 1px solid currentColor;
  }

  .project-card__actions a:hover {
    color: var(--accent);
  }

  .project-card__actions a:focus-visible {
    outline: 2px solid var(--accent-secondary);
    outline-offset: 4px;
  }

  @media (max-width: 800px) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding: 2rem 0;
    }
  }
</style>
