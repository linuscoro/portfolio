---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Portfolio Marcel·lí Corominas Prats",
  description = "Portfolio personal"
} = Astro.props;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>