---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { getAge } from "../../utils/age";
import ProjectCard from "../../components/ProjectCard.astro";
import Header from "../../components/Header.astro";
import { projects } from "../../data/projects";
import { ca } from "../../i18n/ca";

const age = getAge("2004-12-12");
const t = ca;
---

<Layout
  title="El meu portfolio"
  description="Portfolio personal"
>
  <Header currentLang="ca" />
  <main>
    
    <Hero
      name="Marcel·lí Corominas Prats"
      age={age}
      role={t.hero.role}
      description={t.hero.description}
      ageLabel={t.hero.ageLabel}
      locationLabel={t.hero.locationLabel}
      availabilityLabel={t.hero.availabilityLabel}
    />

    <section id="projects" class="projects">
      <h2>Projectes</h2>

      <div class="projects__grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </main>
</Layout>